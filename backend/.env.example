# ========================================================
# HealthSync Backend Environment Variables (.env.example)
# ========================================================

# Port Express listens on (auto-provided on Render, default 5000)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Frontend Origin for CORS (comma-separated if multiple)
# For local dev: http://localhost:5173
# For production: https://healthsync-dashboard.vercel.app
FRONTEND_URL=https://your-healthsync-frontend.vercel.app

# Persistent Database URL (PostgreSQL)
# Omit or leave blank for zero-config local SQLite (healthsync.db)
# For online persistent cloud deployment (e.g. Neon.tech or Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# IoT Device offline threshold in milliseconds (default: 45000ms = 45s)
DEVICE_OFFLINE_TIMEOUT_MS=45000
